PORT=3000
NODE_ENV=development

# Mongo (Atlas). Incluir el nombre de la base en la URI: mongodb+srv://USER:PASS@cluster.mongodb.net/peliculas
MONGODB_URI=

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# URL publica del FRONT (las requests a /api llegan por el proxy / rewrite).
# Local: http://localhost:5173   |   Render: https://<tu-front>.onrender.com
BETTER_AUTH_URL=http://localhost:5173

# OAuth App de GitHub (una para local y otra para produccion)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (Google Cloud Console > APIs y servicios > Credenciales). Opcional pero recomendado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq (LLM del agente). Key gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: cualquier modelo de Groq con tool calling
GROQ_MODEL=openai/gpt-oss-20b

# Solo para `npm run seed` (usuarios de prueba). Opcional: hay valores por defecto.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
